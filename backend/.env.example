# ============================================================================
# AI HOSPITAL PATIENT FEEDBACK SYSTEM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# COPY TO .env AND FILL IN YOUR SECURE CREDENTIALS. NEVER COMMIT .env TO GIT!
# ============================================================================

APP_NAME="AI Hospital Patient Feedback System"
ENVIRONMENT=production
DEBUG=False
PORT=8001

# Security & JWT (Generate a 32+ character random string for production: `openssl rand -hex 32`)
SECRET_KEY=generate_a_random_32_plus_char_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Retention Webhook Secret (For managed cloud schedulers like Cloud Scheduler / EventBridge)
CRON_SECRET=generate_a_random_cron_webhook_secret_here

# Central Managed Database:
# For local zero-dependency out-of-the-box development:
# DATABASE_URL=sqlite:///./data/hospital_feedback.db
# For production cloud PostgreSQL (Render, Neon, Supabase, Railway, AWS RDS):
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Allowed CORS Origins (Include your deployed mobile PWA domain):
CORS_ORIGINS=https://your-hospital-pwa.vercel.app,https://your-hospital-pwa.netlify.app,http://localhost:5174

# Audio Storage & Privacy Retention Policy:
AUDIO_STORAGE_DIR=/app/data/audio
AUDIO_RETENTION_POLICY=keep
MAX_AUDIO_MB=50

# AI Provider Configuration ('gemini', 'openai', or 'mock'):
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Server-Side Master Administrator Account:
# Set your secure Master administrative credentials here.
MASTER_USERNAME=your_master_username_here
MASTER_PASSWORD=your_secure_master_password_here
MASTER_DISPLAY_NAME="Hospital Master Administrator"
