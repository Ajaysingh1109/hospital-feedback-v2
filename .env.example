# ==============================================================================
# Hospital Patient Feedback System - Docker Compose Environment Template
# COPY THIS FILE TO .env AND SET YOUR PRODUCTION SECRETS. NEVER COMMIT .env TO GIT!
# ==============================================================================

# Application Port
PORT=8001

# PostgreSQL Database Service
POSTGRES_USER=hospital_db_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=hospital_feedback

# Backend Database URL (points to PostgreSQL service inside Docker Compose)
DATABASE_URL=postgresql://hospital_db_user:generate_a_secure_postgres_password_here@db:5432/hospital_feedback

# Application Security & JWT Secret (Generate via: `openssl rand -hex 32`)
SECRET_KEY=generate_a_random_32_plus_char_secret_key_here

# Retention Cron Webhook Secret (Generate via: `openssl rand -hex 24`)
CRON_SECRET=generate_a_random_cron_webhook_secret_here

# Master Administrator Credentials (Initialized securely on first boot)
MASTER_USERNAME=your_master_admin_username
MASTER_PASSWORD=your_strong_master_admin_password
MASTER_DISPLAY_NAME="Hospital Master Administrator"

# AI Provider Configuration (Google Gemini API Key for transcription/translation)
GEMINI_API_KEY=your_gemini_api_key_here
